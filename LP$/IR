# Program to implement PageRank Algorithm

def pagerank(graph, damping=0.85, iterations=10):
    pages = list(graph.keys())
    n = len(pages)

    # Initialize PageRank values
    rank = {page: 1 / n for page in pages}

    for _ in range(iterations):
        new_rank = {}

        for page in pages:
            new_rank[page] = (1 - damping) / n

            for other in pages:
                if page in graph[other]:
                    new_rank[page] += (
                        damping * rank[other] / len(graph[other])
                    )

        rank = new_rank

    return rank


# Web graph: each page links to other pages
graph = {
    'A': ['B', 'C'],
    'B': ['C'],
    'C': ['A']
}

# Calculate PageRank
result = pagerank(graph)

print("PageRank Scores:")
for page, score in sorted(result.items()):
    print(page, ":", round(score, 4))


