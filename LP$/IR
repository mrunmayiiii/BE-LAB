import math
from collections import Counter

# Input two documents
doc1 = input("Enter first document: ").lower()
doc2 = input("Enter second document: ").lower()

# Split documents into words
words1 = doc1.split()
words2 = doc2.split()

# Calculate word frequencies
freq1 = Counter(words1)
freq2 = Counter(words2)

# Calculate dot product
dot_product = 0
for word in freq1:
    dot_product += freq1[word] * freq2[word]

# Calculate magnitude of each document
mag1 = math.sqrt(sum(count ** 2 for count in freq1.values()))
mag2 = math.sqrt(sum(count ** 2 for count in freq2.values()))

# Calculate cosine similarity
if mag1 != 0 and mag2 != 0:
    similarity = dot_product / (mag1 * mag2)
else:
    similarity = 0

# Display result
print("Cosine Similarity:", round(similarity, 4))
print("Similarity Percentage:", round(similarity * 100, 2), "%")



