from collections import defaultdict

# Given dataset
data = "Hello World! Map Reduce Programming 123"

# Mapper function
def mapper(data):
    result = []
    for ch in data:
        if ch.isalpha():
            result.append((ch.lower(), 1))
    return result

# Reducer function
def reducer(mapped_data):
    count = defaultdict(int)
    for ch, value in mapped_data:
        count[ch] += value
    return count

# Map phase
mapped_data = mapper(data)

# Reduce phase
result = reducer(mapped_data)

# Display character counts
for ch in sorted(result):
    print(ch, ":", result[ch])


