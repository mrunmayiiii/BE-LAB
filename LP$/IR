
import xml.etree.ElementTree as ET
import numpy as np

# XML data containing web pages and hyperlinks
xml_data = """
<webpages>
    <page id="A" topic="cybersecurity">
        <link>B</link>
        <link>C</link>
    </page>
    <page id="B" topic="sports">
        <link>C</link>
    </page>
    <page id="C" topic="cybersecurity">
        <link>A</link>
    </page>
</webpages>
"""

# Step 1: Parse XML
root = ET.fromstring(xml_data)

pages = {}
topics = {}

for page in root.findall("page"):
    page_id = page.get("id")
    pages[page_id] = [link.text for link in page.findall("link")]
    topics[page_id] = page.get("topic")

nodes = list(pages.keys())
n = len(nodes)

print("Web Graph:")
for page in nodes:
    print(page, "->", pages[page])

# Step 2: Create the transition matrix
# M[i][j] = probability of moving from page j to page i
M = np.zeros((n, n))

for j, page in enumerate(nodes):
    links = pages[page]

    if links:
        for link in links:
            if link in nodes:
                i = nodes.index(link)
                M[i][j] += 1 / len(links)
    else:
        # Handle pages with no outgoing links
        M[:, j] = 1 / n

# Step 3: Create topic preference vector
topic = input("\nEnter topic (cybersecurity/sports): ").lower()

preference = np.array([
    1 if topics[node] == topic else 0
    for node in nodes
], dtype=float)

if preference.sum() == 0:
    print("Topic not found!")
    exit()

preference = preference / preference.sum()

# Step 4: Compute Topic-Specific PageRank
d = 0.85
rank = preference.copy()

for iteration in range(100):
    new_rank = (1 - d) * preference + d * M @ rank

    if np.linalg.norm(new_rank - rank, 1) < 1e-8:
        rank = new_rank
        break

    rank = new_rank

# Step 5: Display results
print("\nTopic-Specific PageRank for:", topic)

for node, score in sorted(
    zip(nodes, rank), key=lambda x: x[1], reverse=True
):
    print(f"Page {node}: {score:.4f}")



