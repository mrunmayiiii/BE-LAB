int main()
{
    ofstream fout("system_log.txt", ios::app);

    if (!fout)
    {
        cout << "Error opening log file!" << endl;
        return 1;
    }

    int n;
    cout << "Enter number of events to capture: ";
    cin >> n;

    map<string, int> failedLogins;
    string time, ip, event;

    for (int i = 0; i < n; i++)
    {
        cout << "\nEvent " << i + 1 << endl;

        cout << "Enter timestamp: ";
        cin >> time;

        cout << "Enter IP address: ";
        cin >> ip;

        cout << "Enter event (FAILED or SUCCESS): ";
        cin >> event;

        fout << time << " " << ip << " " << event << endl;

        // Event correlation
        if (event == "FAILED")
        {
            failedLogins[ip]++;
        }
    }

    fout.close();

    cout << "\n--- Event Correlation Report ---\n";

    for (auto entry : failedLogins)
    {
        cout << "IP Address: " << entry.first
             << " | Failed Attempts: " << entry.second;

        if (entry.second >= 3)
        {
            cout << " | ALERT: Possible Brute-Force Attack!";
        }

        cout << endl;
    }

    cout << "\nLogs saved successfully in system_log.txt\n";

    return 0;
}


