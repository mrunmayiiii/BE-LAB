
from email import policy
from email.parser import Parser
import re

# Read email header from the user
print("Enter the email header (enter a blank line to finish):")

header_lines = []

while True:
    line = input()
    if line == "":
        break
    header_lines.append(line)

header_text = "\n".join(header_lines)

# Parse the email header
email_data = Parser(policy=policy.default).parsestr(
    header_text + "\n\n"
)

print("\n----- EMAIL HEADER ANALYSIS -----")

# Display important header fields
fields = [
    "From",
    "To",
    "Date",
    "Subject",
    "Reply-To",
    "Return-Path",
    "Message-ID"
]

for field in fields:
    print(f"{field}: {email_data.get(field, 'Not available')}")

# Analyze Received headers to find routing information
received_headers = email_data.get_all("Received", [])

print("\n----- EMAIL ROUTING DETAILS -----")

if received_headers:
    for i, received in enumerate(received_headers, 1):
        print(f"Hop {i}: {received}")

        # Extract IPv4 addresses
        ips = re.findall(
            r"\b(?:\d{1,3}\.){3}\d{1,3}\b",
            str(received)
        )

        for ip in ips:
            print("  IP Address:", ip)
else:
    print("No Received headers found.")

# Basic suspicious-email indicators
print("\n----- INVESTIGATION CHECKS -----")

sender = email_data.get("From", "")
reply_to = email_data.get("Reply-To", "")
return_path = email_data.get("Return-Path", "")

if reply_to and reply_to != sender:
    print("Warning: Reply-To differs from From.")

if return_path and return_path != sender:
    print("Warning: Return-Path differs from From.")

if not email_data.get("Authentication-Results"):
    print("Authentication-Results header not found.")

print("\nAnalysis completed.")



