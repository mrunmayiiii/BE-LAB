#include <iostream>
#include <fstream>
#include <string>
#include <filesystem>
using namespace std;
namespace fs = std::filesystem;

// Function to recover deleted files from a folder
void recoverFiles() {
    string folder, destination;

    cout << "\nEnter folder to scan: ";
    cin >> folder;

    cout << "Enter destination folder: ";
    cin >> destination;

    if (!fs::exists(folder) || !fs::is_directory(folder)) {
        cout << "Invalid folder!\n";
        return;
    }

    fs::create_directories(destination);
    int count = 0;

    cout << "\nScanning files...\n";

    for (const auto& entry : fs::recursive_directory_iterator(
             folder, fs::directory_options::skip_permission_denied)) {
        if (entry.is_regular_file()) {
            cout << "Found: " << entry.path().string() << "\n";
            cout << "Copy this file? (y/n): ";

            char choice;
            cin >> choice;

            if (choice == 'y' || choice == 'Y') {
                try {
                    fs::copy_file(
                        entry.path(),
                        fs::path(destination) / entry.path().filename(),
                        fs::copy_options::skip_existing
                    );
                    cout << "File copied successfully.\n";
                    count++;
                } catch (const fs::filesystem_error& e) {
                    cout << "Could not copy file.\n";
                }
            }
        }
    }

    cout << "\nFiles copied: " << count << "\n";
    cout << "Note: This scans existing files; it does not recover "
         << "truly deleted files.\n";
}

// Function to detect partition signatures in a disk image
void detectPartitions() {
    string filename;
    cout << "\nEnter disk image filename: ";
    cin >> filename;

    ifstream file(filename, ios::binary);

    if (!file) {
        cout << "Cannot open disk image!\n";
        return;
    }

    // Check MBR signature at byte offsets 510 and 511
    file.seekg(510);
    unsigned char sig[2];
    file.read(reinterpret_cast<char*>(sig), 2);

    if (file.gcount() == 2 && sig[0] == 0x55 && sig[1] == 0xAA)
        cout << "MBR boot signature found.\n";
    else
        cout << "MBR signature not found at offset 510.\n";

    // Search for NTFS boot sector signature
    file.clear();
    file.seekg(0);

    char buffer[512];
    int sector = 0, found = 0;

    while (file.read(buffer, sizeof(buffer)) || file.gcount() > 0) {
        if (file.gcount() >= 4 &&
            buffer[3] == 'N' &&
            buffer[4] == 'T' &&
            buffer[5] == 'F' &&
            buffer[6] == 'S') {
            cout << "Possible NTFS boot sector at offset "
                 << sector * 512 << " bytes.\n";
            found++;
        }
        sector++;
    }

    if (found == 0)
        cout << "No NTFS boot sector signature detected.\n";

    cout << "Signature scan completed.\n";
    cout << "Note: Signatures alone cannot confirm a deleted partition.\n";
    file.close();
}

int main() {
    int choice;

    do {
        cout << "\n===== COMPUTER FORENSIC APPLICATION =====\n";
        cout << "1. Scan and Copy Available Files\n";
        cout << "2. Detect Partition Signatures in Disk Image\n";
        cout << "3. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                recoverFiles();
                break;
            case 2:
                detectPartitions();
                break;
            case 3:
                cout << "Exiting application.\n";
                break;
            default:
                cout << "Invalid choice!\n";
        }
    } while (choice != 3);

    return 0;
}


